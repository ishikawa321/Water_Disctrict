<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Loaded only when Windows client-area animation is enabled. Render transforms never move layout. -->
  <Style Selector="Button">
    <Setter Property="RenderTransform" Value="translate(0px, 0px) scale(1)"/>
    <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut"/>
        <BrushTransition Property="Background" Duration="0:0:0.16"/>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.16"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="RenderTransform" Value="translate(0px, -2px) scale(1)"/>
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform" Value="translate(0px, 0px) scale(0.98)"/>
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="RenderTransform" Value="translate(0px, 0px) scale(1)"/>
  </Style>
  <Style Selector="ListBox.navigation ListBoxItem">
    <Setter Property="RenderTransform" Value="translateX(0px)"/>
    <Setter Property="Transitions"><Transitions>
      <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut"/>
      <BrushTransition Property="Background" Duration="0:0:0.16"/>
    </Transitions></Setter>
  </Style>
  <Style Selector="ListBox.navigation ListBoxItem:pointerover">
    <Setter Property="RenderTransform" Value="translateX(3px)"/>
  </Style>
  <Style Selector="UserControl.page-enter">
    <Style.Animations>
      <Animation Duration="0:0:0.22" Easing="CubicEaseOut" FillMode="None">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/><Setter Property="RenderTransform" Value="translate(0px, 10px)"/></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/><Setter Property="RenderTransform" Value="translate(0px, 0px)"/></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
