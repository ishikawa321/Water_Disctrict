<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="using:WaterDistrictConnect.Views" x:Class="WaterDistrictConnect.Views.BillingView">
 <StackPanel Spacing="20">
  <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="6"><TextBlock Text="{Binding Title}" Classes="title"/><TextBlock Text="{Binding Subtitle}" Classes="muted"/></StackPanel><Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}"/></Grid>
  <v:Feedback/>
  <Border Classes="card" IsVisible="{Binding CanManage}"><StackPanel Spacing="12" IsEnabled="{Binding !IsBusy}">
   <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Create or edit a monthly bill" Classes="section"/><Button Grid.Column="1" Content="New bill" Command="{Binding NewBillCommand}"/></Grid>
   <TextBlock Text="Select an existing bill below to edit it, or use New bill." Classes="muted"/>
   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBox Text="{Binding AccountSearch}" Watermark="Search customer name or account number"/><Button Grid.Column="1" Content="Find accounts" Command="{Binding SearchAccountsCommand}"/></Grid>
   <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}" PlaceholderText="Choose customer account" HorizontalAlignment="Stretch"/>
   <WrapPanel Orientation="Horizontal">
    <StackPanel Spacing="6" Margin="0,0,20,12"><TextBlock Text="Billing month (any day in month)"/><DatePicker SelectedDate="{Binding BillingMonth}"/></StackPanel>
    <StackPanel Spacing="6" Margin="0,0,20,12"><TextBlock Text="Payment deadline"/><CalendarDatePicker SelectedDate="{Binding DueDate}" Width="240"/></StackPanel>
    <StackPanel Spacing="6" Margin="0,0,20,12"><TextBlock Text="Amount (PHP)"/><NumericUpDown Value="{Binding Amount}" Minimum="0" Maximum="999999999.99" FormatString="0.00" Width="180"/></StackPanel>
   </WrapPanel>
   <CheckBox Content="Payment received (Paid)" IsChecked="{Binding Paid}"/>
   <Button Content="Save bill" Classes="primary" Command="{Binding SaveCommand}"/>
  </StackPanel></Border>
  <TextBlock Text="No bills found. Bills will appear here when issued by an administrator." IsVisible="{Binding Empty}" Classes="muted"/>
  <TextBlock Text="Unpaid bills automatically become Due today or Overdue based on the payment deadline (Philippine time)." TextWrapping="Wrap" Classes="muted"/>
  <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedBill}" HorizontalContentAlignment="Stretch">
   <ListBox.ItemTemplate><DataTemplate><Border Classes="card" Margin="0,4" Padding="16"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
    <StackPanel Spacing="6"><TextBlock Text="{Binding MonthLabel}" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="{Binding Account}"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Due:"/><TextBlock Text="{Binding DueLabel}"/></StackPanel><TextBlock Text="{Binding PaymentLabel}" Classes="muted"/></StackPanel>
    <StackPanel Grid.Column="1" Spacing="10" HorizontalAlignment="Right"><TextBlock Text="{Binding AmountLabel}" FontWeight="SemiBold" FontSize="18"/><Border Classes="status-pill"><TextBlock Text="{Binding Status}"/></Border></StackPanel>
   </Grid></Border></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
 </StackPanel>
</UserControl>
