<UserControl xmlns="https://github.com/avaloniaui" xmlns:v="using:WaterDistrictConnect.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WaterDistrictConnect.Views.SubmitView" Classes="page-enter">
 <StackPanel Spacing="20">
  <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="13"><Path Data="{StaticResource IconAdd}" Classes="heading-icon"/><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Submit a Concern" Classes="title"/><TextBlock Text="Tell us what's going on with your water service. We'll review it and get back to you." Classes="muted"/></StackPanel><Button Grid.Column="2" Content="Retry account load" Command="{Binding LoadCommand}" Classes="compact" VerticalAlignment="Top" IsVisible="{Binding NotSaved}"/></Grid>
  <v:Feedback/>
  <Grid ColumnDefinitions="*,235" ColumnSpacing="24" IsVisible="{Binding NotSaved}">
   <StackPanel Spacing="8" IsEnabled="{Binding !IsBusy}">
    <StackPanel Spacing="8" IsVisible="{Binding IsEditing}">
     <StackPanel Spacing="8" IsVisible="{Binding IsOffice}"><TextBlock Text="Customer account *" Classes="label"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding AccountSearch}" PlaceholderText="Search account number or name" AutomationProperties.Name="Customer account search"/><Button Grid.Column="1" Content="Search" Command="{Binding LoadCommand}"/></Grid><ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}" PlaceholderText="Select an existing customer account" AutomationProperties.Name="Customer account"/><TextBlock Text="{Binding AccountError}" Classes="validation"/><TextBlock Text="Intake channel *" Classes="label"/><ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}" AutomationProperties.Name="Intake channel"/><TextBlock Text="Recorded by the signed-in office user on behalf of the selected account." Classes="caption"/></StackPanel>
     <Border Classes="notice" Padding="10" IsVisible="{Binding !IsOffice}"><StackPanel Spacing="3"><TextBlock Text="{Binding Account, StringFormat='Linked account: {0}'}" Classes="caption"/><TextBlock Text="{Binding AccountError}" Classes="validation"/></StackPanel></Border>
     <TextBlock Text="Concern Category *" Classes="label"/>
     <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" AutomationProperties.Name="Concern category">
      <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="BorderBrush" Value="{StaticResource Divider}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="Padding" Value="6,12"/><Setter Property="MinHeight" Value="84"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style><Style Selector="ListBoxItem:selected"><Setter Property="BorderBrush" Value="{StaticResource Primary}"/><Setter Property="Background" Value="{StaticResource PrimarySubtle}"/></Style><Style Selector="ListBoxItem:focus-visible"><Setter Property="BorderBrush" Value="{StaticResource Primary}"/><Setter Property="BorderThickness" Value="2"/></Style></ListBox.Styles>
      <ListBox.ItemTemplate><DataTemplate><StackPanel Spacing="8" HorizontalAlignment="Center"><Path Data="{Binding Icon}" Classes="icon" Width="24" Height="24" Stroke="{StaticResource PrimaryPressed}"/><TextBlock Text="{Binding Label}" FontSize="11" TextAlignment="Center" HorizontalAlignment="Center"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock Text="{Binding CategoryError}" Classes="validation"/>
     <TextBlock Text="Subject *" Classes="label"/><TextBox Text="{Binding Subject}" PlaceholderText="Briefly describe the issue" MaxLength="160" AutomationProperties.Name="Concern subject"/><TextBlock Text="{Binding SubjectError}" Classes="validation"/>
     <TextBlock Text="Description *" Classes="label"/><TextBox Text="{Binding Description}" PlaceholderText="Describe what happened and where you noticed it." AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxLength="4000" AutomationProperties.Name="Concern description"/><TextBlock Text="{Binding DescriptionError}" Classes="validation"/>
     <Grid ColumnDefinitions="16,*" ColumnSpacing="8"><Path Data="{StaticResource IconInfo}" Classes="icon" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0"/><TextBlock Grid.Column="1" Text="Tip: Include when you first noticed the issue and any helpful details (e.g., location or visible leak)." Classes="caption"/></Grid>
     <TextBlock Text="Service Address *" Classes="label"/><TextBox Text="{Binding Location}" MaxLength="300" AutomationProperties.Name="Service location"><TextBox.InnerLeftContent><Path Data="{StaticResource IconPin}" Classes="icon" Width="16" Height="17" Margin="10,0,0,0"/></TextBox.InnerLeftContent></TextBox><TextBlock Text="{Binding LocationError}" Classes="validation"/>
     <TextBlock Text="Contact details (optional)" Classes="label"/><TextBox Text="{Binding Contact}" MaxLength="200" PlaceholderText="Phone number or preferred contact instructions" AutomationProperties.Name="Optional contact details"/><TextBlock Text="{Binding ContactError}" Classes="validation"/>
     <Button Content="Review concern  ›" Command="{Binding ReviewCommand}" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding CanSubmit}" Margin="0,8,0,0"/>
    </StackPanel>
    <Border Classes="card" IsVisible="{Binding IsReviewing}"><StackPanel Spacing="16"><TextBlock Text="Review your concern" Classes="section"/><TextBlock Text="Check these details before sending them to the service desk." Classes="muted"/><TextBlock Text="{Binding Category.Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Subject}" Classes="section"/><TextBlock Text="{Binding Description}"/><TextBlock Text="Service address" Classes="label"/><TextBlock Text="{Binding Location}"/><TextBlock Text="Contact details" Classes="label"/><TextBlock Text="{Binding Contact}" Classes="muted"/><TextBlock Text="{Binding Account, StringFormat='Customer account: {0}'}" Classes="muted"/><StackPanel Spacing="10" IsVisible="{Binding IsOffice}"><TextBlock Text="{Binding Channel, StringFormat='Office intake: {0}'}" Classes="muted"/></StackPanel><Border Classes="notice"><TextBlock Text="Submitting records an automatic receipt. It does not mean office personnel have responded." Classes="caption"/></Border><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><Button Content="Edit details" Command="{Binding EditCommand}"/><Button Grid.Column="1" Content="Submit concern" Classes="primary" Command="{Binding SubmitCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/></Grid></StackPanel></Border>
   </StackPanel>
   <Border Grid.Column="1" Classes="notice" VerticalAlignment="Top" Padding="17"><StackPanel Spacing="22"><Grid ColumnDefinitions="20,*" ColumnSpacing="10"><Path Data="M5,22 V3 M5,4 C10,0 15,8 21,3 V14 C15,19 10,10 5,15" Classes="icon" Stroke="{StaticResource PrimaryPressed}"/><TextBlock Grid.Column="1" Text="What happens next?" FontWeight="Bold"/></Grid><Grid ColumnDefinitions="24,*" ColumnSpacing="10"><Border Background="{StaticResource Primary}" Width="22" Height="22" CornerRadius="11" VerticalAlignment="Top"><TextBlock Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Border><StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="We receive your concern." FontWeight="SemiBold" FontSize="13"/><TextBlock Text="A reference is saved for your account. Receipt is automatic." Classes="caption"/></StackPanel></Grid><Grid ColumnDefinitions="24,*" ColumnSpacing="10"><Border Background="{StaticResource Primary}" Width="22" Height="22" CornerRadius="11" VerticalAlignment="Top"><TextBlock Text="2" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Border><StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Our office reviews it." FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Authorized personnel check the details and classification." Classes="caption"/></StackPanel></Grid><Grid ColumnDefinitions="24,*" ColumnSpacing="10"><Border Background="{StaticResource Primary}" Width="22" Height="22" CornerRadius="11" VerticalAlignment="Top"><TextBlock Text="3" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Border><StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="You can follow updates." FontWeight="SemiBold" FontSize="13"/><TextBlock Text="View the current status and office replies in My Concerns." Classes="caption"/></StackPanel></Grid></StackPanel></Border>
  </Grid>
  <Border Classes="card" IsVisible="{Binding !NotSaved}"><StackPanel Spacing="16"><Path Data="M3,12 L9,18 21,5" Classes="icon" Width="38" Height="38" Stroke="{StaticResource Success}" HorizontalAlignment="Left"/><TextBlock Text="Received — awaiting office review" Classes="section"/><TextBlock Text="Your concern is saved. This is an automatic acknowledgement; staff have not yet responded." Classes="muted"/><Button Content="View concern  ›" Classes="primary" Command="{Binding ViewSavedCommand}"/></StackPanel></Border>
 </StackPanel>
</UserControl>

