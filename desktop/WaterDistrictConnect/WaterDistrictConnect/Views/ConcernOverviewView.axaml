<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="using:WaterDistrictConnect.Views" x:Class="WaterDistrictConnect.Views.ConcernOverviewView" Classes="page-enter">
 <StackPanel Spacing="22">
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="6"><TextBlock Text="{Binding Greeting}" Classes="title"/><TextBlock Text="Here's what's happening at Maramag Water Service Desk today." Classes="muted" IsVisible="{Binding !IsClient}"/><TextBlock Text="You can submit a concern, check its current status,&#10;and view updates from our office - all in one place." Classes="muted" IsVisible="{Binding IsClient}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top"><Button Content="Refresh" Command="{Binding RefreshCommand}" Classes="compact"/><Button Content="+  Register Concern" Classes="primary" Command="{Binding SubmitCommand}" IsVisible="{Binding !IsClient}" IsEnabled="{Binding CanSubmit}"/></StackPanel></Grid>
  <v:Feedback/>
  <Button Classes="primary" Command="{Binding SubmitCommand}" IsVisible="{Binding IsClient}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20,14"><Grid ColumnDefinitions="28,*,20" ColumnSpacing="12"><Path Data="{StaticResource IconAdd}" Classes="icon" Stroke="White" Width="24" Height="24"/><TextBlock Text="Submit a concern" FontSize="18" FontWeight="SemiBold" Grid.Column="1" VerticalAlignment="Center"/><TextBlock Text="›" FontSize="28" Grid.Column="2" VerticalAlignment="Center"/></Grid></Button>
  <UniformGrid Columns="{Binding MetricColumns}" Margin="-8,0">
   <Border Classes="card" Margin="8,0"><Grid ColumnDefinitions="48,*" ColumnSpacing="14"><Border Classes="stat-icon"><Path Data="{StaticResource IconConcern}" Classes="icon" Width="25" Height="25" Stroke="{StaticResource Teal}"/></Border><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Summary.Open}" Classes="stat-value"/><TextBlock Text="Open concerns" FontSize="13"/><TextBlock Text="Awaiting action" Classes="caption" IsVisible="{Binding !IsClient}"/></StackPanel></Grid></Border>
   <Border Grid.Column="1" Classes="card" Margin="8,0"><Grid ColumnDefinitions="48,*" ColumnSpacing="14"><Border Classes="stat-icon"><Path Data="{StaticResource IconClock}" Classes="icon" Width="25" Height="25" Stroke="{StaticResource Teal}"/></Border><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Summary.UnderReview}" Classes="stat-value"/><TextBlock Text="Under review" FontSize="13"/><TextBlock Text="Office review in progress" Classes="caption" IsVisible="{Binding !IsClient}"/></StackPanel></Grid></Border>
   <Border Grid.Column="2" Classes="card" Margin="8,0" IsVisible="{Binding !IsClient}"><Grid ColumnDefinitions="48,*" ColumnSpacing="14"><Border Classes="stat-icon"><Path Data="{StaticResource IconReply}" Classes="icon" Width="25" Height="25" Stroke="{StaticResource Teal}"/></Border><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Summary.Submitted}" Classes="stat-value"/><TextBlock Text="Awaiting review" FontSize="13"/><TextBlock Text="Received by the service desk" Classes="caption" IsVisible="{Binding !IsClient}"/></StackPanel></Grid></Border>
  </UniformGrid>
  <Grid ColumnDefinitions="*,*" ColumnSpacing="18" IsVisible="{Binding !IsClient}">
   <Border Classes="card"><StackPanel Spacing="14"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Awaiting Review" Classes="section"/><Button Grid.Column="1" Classes="link compact" Content="View Queue →" Command="{Binding AwaitingCommand}"/></Grid><TextBlock Text="No concerns awaiting review." Classes="muted" IsVisible="{Binding NoPendingReview}"/><ItemsControl ItemsSource="{Binding Summary.PendingReview}"><ItemsControl.ItemTemplate><DataTemplate><Button Classes="link" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding $parent[UserControl].DataContext.OpenCommand}" CommandParameter="{Binding}"><Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="0,10"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel Spacing="4"><TextBlock Text="{Binding Reference}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding Subject}" FontSize="13"/><TextBlock Text="{Binding Account}" Classes="caption"/></StackPanel><Border Classes="status-pill submitted" Grid.Column="1" VerticalAlignment="Top"><TextBlock Text="Submitted"/></Border></Grid></Border></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
   <Border Grid.Column="1" Classes="card"><StackPanel Spacing="14"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Recent Activity" Classes="section"/><Button Content="View All →" Classes="link compact" Grid.Column="1" Command="{Binding AllCommand}"/></Grid><TextBlock Text="No recorded activity yet." Classes="muted" IsVisible="{Binding !HasActivity}"/><ItemsControl ItemsSource="{Binding Summary.Activity}"><ItemsControl.ItemTemplate><DataTemplate><Button Classes="link" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding $parent[UserControl].DataContext.OpenActivityCommand}" CommandParameter="{Binding}"><Grid ColumnDefinitions="20,*" ColumnSpacing="12" Margin="0,7"><Path Classes="icon" Data="{StaticResource IconConcern}" Width="17" Height="17" VerticalAlignment="Top" Margin="0,3,0,0"/><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{Binding Reference}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Event.DisplayKind}" FontSize="13"/><TextBlock Text="{Binding Event.Header}" Classes="caption"/></StackPanel></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
  </Grid>
  <Border Classes="card" IsVisible="{Binding IsClient}"><StackPanel Spacing="16"><StackPanel Orientation="Horizontal" Spacing="10"><Path Data="{StaticResource IconClock}" Classes="icon"/><TextBlock Text="Recent update" Classes="section"/></StackPanel><StackPanel Spacing="8" IsVisible="{Binding HasActivity}"><TextBlock Text="{Binding LatestActivity.Reference}" FontWeight="SemiBold"/><TextBlock Text="{Binding LatestActivity.Event.DisplayKind}"/><TextBlock Text="{Binding LatestActivity.Event.Text}" Classes="muted" MaxLines="3" TextTrimming="CharacterEllipsis"/><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding LatestActivity.Event.Header}" Classes="caption" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="subtle compact" Content="View details  ›" Command="{Binding OpenLatestCommand}"/></Grid></StackPanel><TextBlock Text="No updates yet. Submit a concern to start a clear service record." Classes="muted" IsVisible="{Binding !HasActivity}"/></StackPanel></Border>
  <Border Classes="service-notice" IsVisible="{Binding IsClient}"><Grid ColumnDefinitions="24,*" ColumnSpacing="14"><Path Classes="icon" Data="{StaticResource IconInfo}" Stroke="{StaticResource Teal}"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Service availability" FontWeight="SemiBold"/><TextBlock Text="Office personnel review concerns during routine office availability. Receipt is automatic and does not mean staff have responded." Classes="caption"/></StackPanel></Grid></Border>
 </StackPanel>
</UserControl>
