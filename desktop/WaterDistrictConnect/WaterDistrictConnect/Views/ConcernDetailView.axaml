<UserControl xmlns="https://github.com/avaloniaui" xmlns:v="using:WaterDistrictConnect.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WaterDistrictConnect.Views.ConcernDetailView" Classes="page-enter">
 <UserControl.Resources>
  <DataTemplate x:Key="TimelineTemplate"><Grid ColumnDefinitions="23,*" ColumnSpacing="10" MinHeight="95"><Border Width="1" Background="#9CCBDD" HorizontalAlignment="Center" Margin="0,15,0,0"/><Border Background="{StaticResource Primary}" Width="13" Height="13" CornerRadius="7" VerticalAlignment="Top" Margin="0,3,0,0" BorderBrush="#E8F7FD" BorderThickness="2"/><StackPanel Grid.Column="1" Spacing="5" Margin="0,0,0,18"><TextBlock Text="{Binding DisplayKind}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{Binding Header}" Classes="caption"/><TextBlock Text="{Binding StateChange}" Classes="caption" Foreground="{StaticResource PrimaryPressed}"/><TextBlock Text="{Binding Text}" FontSize="12"/><Border Classes="status-pill submitted" IsVisible="{Binding Internal}" Margin="0,3"><TextBlock Text="Internal — staff only"/></Border></StackPanel></Grid></DataTemplate>
 </UserControl.Resources>
 <StackPanel Spacing="18">
  <Button Content="‹  Back to concerns" Command="{Binding BackCommand}" Classes="link"/>
  <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="13"><Path Data="{StaticResource IconConcern}" Classes="heading-icon"/><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{Binding Title}" Classes="title"/><TextBlock Text="Details and updates for this concern." Classes="muted" IsVisible="{Binding !IsOffice}"/><TextBlock Text="{Binding Detail.Row.DateLabel, StringFormat='Reported {0}'}" Classes="muted" IsVisible="{Binding IsOffice}"/><TextBlock Text="{Binding Attribution}" Classes="caption" IsVisible="{Binding IsOffice}"/></StackPanel><Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Top"/></Grid>
  <v:Feedback/>
  <Grid ColumnDefinitions="*,290" ColumnSpacing="20" IsVisible="{Binding IsOffice}">
   <StackPanel Spacing="16">
    <Border Classes="card" Padding="16"><StackPanel Spacing="12"><StackPanel Orientation="Horizontal" Spacing="9"><Path Data="{StaticResource IconUser}" Classes="icon" Width="18" Height="18"/><TextBlock Text="Customer Information" Classes="section"/></StackPanel><Grid ColumnDefinitions="115,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8"><TextBlock Text="Account" Classes="caption"/><TextBlock Text="{Binding Detail.Row.Account}" Grid.Column="1" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Address" Grid.Row="1" Classes="caption"/><TextBlock Text="{Binding Detail.Location}" Grid.Row="1" Grid.Column="1" FontSize="13"/><TextBlock Text="Contact" Grid.Row="2" Classes="caption"/><TextBlock Text="{Binding Detail.Contact}" Grid.Row="2" Grid.Column="1" FontSize="13"/></Grid></StackPanel></Border>
    <Border Classes="card" Padding="16"><StackPanel Spacing="12"><StackPanel Orientation="Horizontal" Spacing="9"><Path Data="{StaticResource IconConcern}" Classes="icon" Width="18" Height="18"/><TextBlock Text="Concern Details" Classes="section"/></StackPanel><TextBlock Text="{Binding Detail.Row.Subject}" FontWeight="SemiBold"/><Grid ColumnDefinitions="115,*" RowDefinitions="Auto,Auto" RowSpacing="8"><TextBlock Text="Category" Classes="caption"/><TextBlock Grid.Column="1" Text="{Binding Detail.Row.CategoryLabel}" FontSize="13"/><TextBlock Grid.Row="1" Text="Description" Classes="caption"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Detail.Description}" FontSize="13"/></Grid><Border Classes="status-pill" Classes.submitted="{Binding Detail.Row.IsSubmitted}" Classes.resolved="{Binding Detail.Row.IsResolved}" Classes.closed="{Binding Detail.Row.IsClosed}"><TextBlock Text="{Binding Detail.Row.StateLabel}"/></Border></StackPanel></Border>
    <Border Classes="card" IsVisible="{Binding CanRespond}" Padding="0"><StackPanel Spacing="0" IsEnabled="{Binding !IsBusy}">
     <Grid ColumnDefinitions="*,*"><Button Content="Customer Response" Command="{Binding CustomerResponseCommand}" Classes.subtle="{Binding IsCustomerResponse}" IsEnabled="{Binding CanWriteResponse}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="8,0,0,0"/><Button Grid.Column="1" Content="Internal Note (Staff Only)" Command="{Binding InternalNoteCommand}" Classes.subtle="{Binding IsNote}" IsEnabled="{Binding CanWriteInternalNote}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="0,8,0,0"/></Grid>
     <StackPanel Spacing="8" Margin="14"><TextBlock Text="{Binding EditorHeading}" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding AvailableActions}" SelectedItem="{Binding Action, Mode=OneWay}" SelectionChanged="OfficeActionSelected" PlaceholderText="Select an office action" AutomationProperties.Name="Office action"/><StackPanel Spacing="8" IsVisible="{Binding IsReclassify}"><TextBlock Text="Correct category" Classes="label"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" AutomationProperties.Name="Correct classification"/></StackPanel><TextBox Text="{Binding Response}" AutomationProperties.Name="Office response or reason" PlaceholderText="{Binding EditorHint}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="76" MaxLength="4000"/><TextBlock Text="{Binding ResponseError}" Classes="validation"/><Border Classes="notice" Padding="10" IsVisible="{Binding IsInternal}"><TextBlock Text="Staff only. This note or reason is hidden from the customer and does not count as a human response." Classes="caption"/></Border><Button Content="{Binding SaveLabel}" Classes="primary" Command="{Binding RespondCommand}" HorizontalAlignment="Right"/></StackPanel>
    </StackPanel></Border>
   </StackPanel>
   <Border Grid.Column="1" Classes="card" VerticalAlignment="Top"><StackPanel Spacing="18"><StackPanel Orientation="Horizontal" Spacing="9"><Path Data="{StaticResource IconClock}" Classes="icon" Width="19" Height="19"/><TextBlock Text="Timeline" Classes="section"/></StackPanel><ItemsControl ItemsSource="{Binding Detail.Timeline}" ItemTemplate="{StaticResource TimelineTemplate}"/><Border BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="0,14,0,0"><StackPanel Spacing="6"><TextBlock Text="First human response" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding ResponseTime}" Classes="caption"/></StackPanel></Border></StackPanel></Border>
  </Grid>
  <StackPanel Spacing="20" IsVisible="{Binding !IsOffice}">
   <Border Classes="card" Background="#EDF5FA"><Grid ColumnDefinitions="*,*" ColumnSpacing="24"><StackPanel Spacing="6"><TextBlock Text="Reference" Classes="caption"/><TextBlock Text="{Binding Detail.Row.Reference}" FontWeight="Bold" FontSize="17"/><TextBlock Text="{Binding Detail.Row.DateLabel}" Classes="caption"/></StackPanel><StackPanel Grid.Column="1" Spacing="7"><TextBlock Text="Category" Classes="caption"/><StackPanel Orientation="Horizontal" Spacing="10"><Path Data="{Binding Detail.Row.CategoryIcon}" Classes="icon" Stroke="{StaticResource Primary}"/><TextBlock Text="{Binding Detail.Row.CategoryLabel}" FontWeight="SemiBold"/></StackPanel><Border Classes="status-pill" Classes.submitted="{Binding Detail.Row.IsSubmitted}" Classes.resolved="{Binding Detail.Row.IsResolved}" Classes.closed="{Binding Detail.Row.IsClosed}"><TextBlock Text="{Binding Detail.Row.ShortStateLabel}"/></Border></StackPanel></Grid></Border>
   <StackPanel Spacing="12"><StackPanel Orientation="Horizontal" Spacing="10"><Path Data="{StaticResource IconConcern}" Classes="icon" Stroke="{StaticResource PrimaryPressed}"/><TextBlock Text="Submitted concern" Classes="section"/></StackPanel><TextBlock Text="{Binding Detail.Row.Subject}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail.Description}"/><TextBlock Text="{Binding Detail.Location, StringFormat='Service address: {0}'}" Classes="muted"/></StackPanel>
   <Border Classes="notice" IsVisible="{Binding HasReply}"><StackPanel Spacing="12"><Grid ColumnDefinitions="22,*,Auto" ColumnSpacing="10"><Path Data="{StaticResource IconReply}" Classes="icon" Stroke="{StaticResource PrimaryPressed}"/><TextBlock Grid.Column="1" Text="Latest reply from our office" FontWeight="Bold"/></Grid><TextBlock Text="{Binding LatestReply.Text}"/><TextBlock Text="{Binding LatestReply.Header}" Classes="caption"/></StackPanel></Border>
   <Border Classes="card"><StackPanel Spacing="18"><StackPanel Orientation="Horizontal" Spacing="10"><Path Data="{StaticResource IconClock}" Classes="icon" Stroke="{StaticResource PrimaryPressed}"/><TextBlock Text="Update timeline" Classes="section"/></StackPanel><ItemsControl ItemsSource="{Binding Detail.Timeline}" ItemTemplate="{StaticResource TimelineTemplate}"/><TextBlock Text="{Binding ResponseTime, StringFormat='First human response: {0}'}" Classes="caption"/></StackPanel></Border>
   <Border Classes="service-notice"><StackPanel Spacing="5"><TextBlock Text="Your service record" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail.Channel, StringFormat='Intake channel: {0}'}" Classes="caption"/><TextBlock Text="{Binding Detail.RecordedBy, StringFormat='Recorded by: {0}'}" Classes="caption"/></StackPanel></Border>
  </StackPanel>
 </StackPanel>
</UserControl>

