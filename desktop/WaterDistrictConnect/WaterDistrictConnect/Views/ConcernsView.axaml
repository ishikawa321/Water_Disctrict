<UserControl xmlns="https://github.com/avaloniaui" xmlns:v="using:WaterDistrictConnect.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WaterDistrictConnect.Views.ConcernsView" Classes="page-enter">
 <StackPanel Spacing="20">
  <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="13"><Path Data="{StaticResource IconConcern}" Classes="heading-icon"/><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{Binding Title}" Classes="title"/><TextBlock Text="{Binding Subtitle}" Classes="muted"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top"><Button Content="Refresh" Command="{Binding RefreshCommand}" Classes="compact"/><Button Content="{Binding RegisterLabel}" Classes="primary" Command="{Binding SubmitCommand}" IsVisible="{Binding CanIntake}"/></StackPanel></Grid>
  <v:Feedback/>
  <Grid ColumnDefinitions="*,185,175,Auto" ColumnSpacing="12" IsEnabled="{Binding !IsBusy}">
   <TextBox AutomationProperties.Name="Search concerns" Text="{Binding Search}" PlaceholderText="{Binding SearchHint}"><TextBox.InnerLeftContent><Path Data="{StaticResource IconSearch}" Classes="icon" Width="15" Height="15" Margin="10,0,0,0"/></TextBox.InnerLeftContent></TextBox>
   <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" AutomationProperties.Name="Category filter"/>
   <ComboBox Grid.Column="2" ItemsSource="{Binding States}" SelectedItem="{Binding State}" AutomationProperties.Name="Status filter" IsVisible="{Binding IsOffice}"/>
   <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"><Button Content="Search" Classes="subtle" Command="{Binding RefreshCommand}"/><Button Content="Reset" Command="{Binding ClearCommand}"/></StackPanel>
  </Grid>
  <ListBox ItemsSource="{Binding States}" SelectedItem="{Binding State}" IsVisible="{Binding !IsOffice}" AutomationProperties.Name="Concern status tabs" IsEnabled="{Binding !IsBusy}">
   <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
   <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="32"/><Setter Property="BorderBrush" Value="{StaticResource Divider}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="14,5"/></Style></ListBox.Styles>
  </ListBox>
  <TextBlock Text="No matching concerns. Adjust the filters or register a concern." IsVisible="{Binding Empty}" Classes="muted" Margin="0,24"/>
  <StackPanel Spacing="0" IsVisible="{Binding IsOffice}">
   <Border Classes="table-header"><Grid ColumnDefinitions="110,2*,1.3*,108,130,62" ColumnSpacing="12"><TextBlock Text="Reference"/><TextBlock Grid.Column="1" Text="Customer / Subject"/><TextBlock Grid.Column="2" Text="Category"/><TextBlock Grid.Column="3" Text="Status"/><TextBlock Grid.Column="4" Text="Date Reported"/></Grid></Border>
   <ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="12,16" Classes="record-row"><Grid ColumnDefinitions="110,2*,1.3*,108,130,62" ColumnSpacing="12"><TextBlock Text="{Binding Reference}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{Binding Account}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding Subject}" Classes="caption"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding CategoryLabel}" FontSize="12" VerticalAlignment="Center"/><Border Grid.Column="3" Classes="status-pill" Classes.submitted="{Binding IsSubmitted}" Classes.resolved="{Binding IsResolved}" Classes.closed="{Binding IsClosed}"><TextBlock Text="{Binding ShortStateLabel}"/></Border><TextBlock Grid.Column="4" Text="{Binding DateLabel}" Classes="caption" VerticalAlignment="Center"/><Button Grid.Column="5" Content="View ›" Classes="compact" Command="{Binding $parent[UserControl].DataContext.OpenCommand}" CommandParameter="{Binding}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel>
  <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding !IsOffice}"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="card record-row" Padding="18" Margin="0,0,0,12"><Grid ColumnDefinitions="36,*,130,110" ColumnSpacing="16"><Path Data="{Binding CategoryIcon}" Classes="icon" Width="27" Height="29" Stroke="{StaticResource Primary}"/><StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{Binding Subject}" FontWeight="SemiBold"/><TextBlock Text="{Binding Reference}" Classes="caption"/><TextBlock Text="{Binding DateLabel}" Classes="caption"/><TextBlock Text="{Binding CategoryLabel, StringFormat='Category: {0}'}" Classes="caption"/></StackPanel><Border Grid.Column="2" Classes="status-pill" Classes.submitted="{Binding IsSubmitted}" Classes.resolved="{Binding IsResolved}" Classes.closed="{Binding IsClosed}"><TextBlock Text="{Binding ShortStateLabel}"/></Border><Button Grid.Column="3" Content="View details  ›" Classes="compact" Command="{Binding $parent[UserControl].DataContext.OpenCommand}" CommandParameter="{Binding}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <Grid ColumnDefinitions="*,Auto" Margin="0,6"><StackPanel Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding RangeLabel}" Classes="caption"/><TextBlock Text="{Binding PageLabel}" Classes="caption"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="‹ Previous" Classes="compact" Command="{Binding PreviousCommand}" IsEnabled="{Binding HasPrevious}"/><Border Background="{StaticResource PrimaryGradient}" CornerRadius="6" Padding="12,6"><TextBlock Text="{Binding PageNumber}" Foreground="White" FontSize="12"/></Border><Button Content="Next ›" Classes="compact" Command="{Binding NextCommand}" IsEnabled="{Binding HasNext}"/></StackPanel></Grid>
 </StackPanel>
</UserControl>
