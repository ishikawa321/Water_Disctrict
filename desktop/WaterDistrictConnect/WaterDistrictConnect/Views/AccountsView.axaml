<UserControl xmlns="https://github.com/avaloniaui" xmlns:v="using:WaterDistrictConnect.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WaterDistrictConnect.Views.AccountsView" Classes="page-enter">
 <StackPanel Spacing="22">
  <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="13"><Path Data="{StaticResource IconUser}" Classes="heading-icon"/><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{Binding Title}" Classes="title"/><TextBlock Text="Your account details for Maramag Water." Classes="muted" IsVisible="{Binding !IsOffice}"/><TextBlock Text="Customer accounts and fictional plumber resources." Classes="muted" IsVisible="{Binding IsOffice}"/></StackPanel><Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Top"/></Grid>
  <v:Feedback/>
  <TextBlock Text="No matching accounts. Adjust the search or refresh to try again." Classes="muted" IsVisible="{Binding Empty}"/>
  <Grid ColumnDefinitions="230,*,230" ColumnSpacing="16" IsVisible="{Binding IsOffice}">
   <Border Classes="card" Padding="14"><StackPanel Spacing="14"><TextBlock Text="Account Directory" Classes="section"/><TextBox Text="{Binding Search}" PlaceholderText="Name or account number..." AutomationProperties.Name="Search customer accounts"/><Button Content="Search accounts" Command="{Binding RefreshCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/><ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}" AutomationProperties.Name="Customer account directory"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="22,*" ColumnSpacing="10"><Path Data="{StaticResource IconUser}" Classes="icon" Width="17" Height="18"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding Number}" Classes="caption"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="{Binding Accounts.Length, StringFormat='Matches: {0} (up to 100)'}" Classes="caption"/></StackPanel></Border>
   <Border Grid.Column="1" Classes="card"><StackPanel Spacing="20"><TextBlock Text="Customer Details" Classes="section"/><Grid ColumnDefinitions="36,*" ColumnSpacing="12"><Border Background="{StaticResource TealSubtle}" CornerRadius="20" Width="34" Height="34"><Path Data="{StaticResource IconUser}" Classes="icon" Stroke="{StaticResource PrimaryPressed}"/></Border><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{Binding Account.Name}" FontWeight="Bold"/><TextBlock Text="{Binding Account.Number}" Classes="caption"/></StackPanel></Grid><Border Height="1" Background="{StaticResource Divider}"/><StackPanel Spacing="7"><TextBlock Text="Service address" Classes="label"/><TextBlock Text="{Binding Account.Address}"/></StackPanel><StackPanel Spacing="7"><TextBlock Text="Account number" Classes="label"/><TextBlock Text="{Binding Account.Number}"/></StackPanel><Border Classes="notice"><TextBlock Text="Account identity and ownership are read-only." Classes="caption"/></Border></StackPanel></Border>
   <Border Grid.Column="2" Classes="card" Padding="14"><StackPanel Spacing="16"><TextBlock Text="Plumber Resources" Classes="section"/><ItemsControl ItemsSource="{Binding Resources}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="0,12"><StackPanel Spacing="7"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Width="7" Height="7" Fill="{StaticResource MutedText}" IsVisible="{Binding !Available}"/><Ellipse Width="7" Height="7" Fill="{StaticResource Success}" IsVisible="{Binding Available}"/><TextBlock Text="{Binding AvailabilityLabel}" Classes="caption"/></StackPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Fictional reference resources; office confirmation required." Classes="caption"/></StackPanel></Border>
  </Grid>
  <Grid ColumnDefinitions="1.4*,1*" ColumnSpacing="22" IsVisible="{Binding !IsOffice}" HorizontalAlignment="Stretch">
   <Border Classes="card" Padding="0"><StackPanel Spacing="0"><Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="20,15"><TextBlock Text="Account Summary" Classes="section"/></Border><StackPanel Margin="20,0">
    <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="0,18"><Grid ColumnDefinitions="24,*" ColumnSpacing="14"><Path Data="{StaticResource IconUser}" Classes="icon"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Account holder" Classes="caption"/><TextBlock Text="{Binding Account.Name}" FontWeight="SemiBold" FontSize="16"/></StackPanel></Grid></Border>
    <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="0,18"><Grid ColumnDefinitions="24,*" ColumnSpacing="14"><Path Data="{StaticResource IconConcern}" Classes="icon"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Account number" Classes="caption"/><TextBlock Text="{Binding Account.Number}" FontWeight="SemiBold" FontSize="16"/></StackPanel></Grid></Border>
    <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="0,18"><Grid ColumnDefinitions="24,*" ColumnSpacing="14"><Path Data="{StaticResource IconUser}" Classes="icon"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Sign-in username" Classes="caption"/><TextBlock Text="{Binding Username}" FontWeight="SemiBold"/></StackPanel></Grid></Border>
    <Border Padding="0,18"><Grid ColumnDefinitions="24,*" ColumnSpacing="14"><Path Data="{StaticResource IconPin}" Classes="icon"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Service address" Classes="caption"/><TextBlock Text="{Binding Account.Address}" FontWeight="SemiBold"/></StackPanel></Grid></Border>
   </StackPanel></StackPanel></Border>
   <StackPanel Grid.Column="1" Spacing="20"><Border Classes="card"><StackPanel Spacing="14"><StackPanel Orientation="Horizontal" Spacing="10"><Path Data="{StaticResource IconInfo}" Classes="icon" Stroke="{StaticResource Primary}"/><TextBlock Text="Need help?" Classes="section"/></StackPanel><TextBlock Text="For concerns or questions about your water service, use the Submit a Concern page." Classes="muted"/><Button Content="Submit a concern  ›" Classes="subtle" Command="{Binding SubmitCommand}" IsVisible="{Binding CanSubmit}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/></StackPanel></Border><Button Command="{Binding SignOutCommand}" IsVisible="{Binding CanLogout}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="12"><Path Data="{StaticResource IconLogout}" Classes="icon"/><TextBlock Text="Sign out"/></StackPanel></Button></StackPanel>
  </Grid>
  <Border Classes="service-notice"><Grid ColumnDefinitions="24,*" ColumnSpacing="14"><Path Data="{StaticResource IconInfo}" Classes="icon" Stroke="{StaticResource Teal}"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Fictional demo data" FontWeight="SemiBold"/><TextBlock Text="This is sample data for demonstration purposes only." Classes="caption"/></StackPanel></Grid></Border>
 </StackPanel>
</UserControl>

