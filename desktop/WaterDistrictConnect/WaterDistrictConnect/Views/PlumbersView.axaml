<UserControl xmlns="https://github.com/avaloniaui" xmlns:v="using:WaterDistrictConnect.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WaterDistrictConnect.Views.PlumbersView" Classes="page-enter">
 <StackPanel Spacing="22">
  <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="13"><Path Data="M4,8 H20 V21 H4 Z M8,8 V3 H16 V8 M4,13 H20" Classes="heading-icon"/><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Plumber Resources" Classes="title"/><TextBlock Text="Fictional resources and recorded availability." Classes="muted"/></StackPanel><Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Top"/></Grid>
  <v:Feedback/><TextBlock Text="No plumber resources found. Refresh or check demo configuration." Classes="muted" IsVisible="{Binding Empty}"/>
  <Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="Resource Directory" Classes="section"/><Border Classes="table-header"><Grid ColumnDefinitions="2*,130,3*" ColumnSpacing="24"><TextBlock Text="Resource"/><TextBlock Grid.Column="1" Text="Availability"/><TextBlock Grid.Column="2" Text="Office note"/></Grid></Border><ItemsControl ItemsSource="{Binding Plumbers}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="10,18" Classes="record-row"><Grid ColumnDefinitions="2*,130,3*" ColumnSpacing="24"><StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><Path Data="{StaticResource IconUser}" Classes="icon"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/></StackPanel><Border Grid.Column="1" Classes="status-pill" Classes.resolved="{Binding Available}" Classes.closed="{Binding !Available}"><TextBlock Text="{Binding AvailabilityLabel}"/></Border><TextBlock Grid.Column="2" Text="{Binding AvailabilityNote}" Classes="muted" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
  <Border Classes="service-notice"><Grid ColumnDefinitions="24,*" ColumnSpacing="14"><Path Data="{StaticResource IconInfo}" Classes="icon" Stroke="{StaticResource Teal}"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Office reference information" FontWeight="SemiBold"/><TextBlock Text="Availability is recorded for this fictional demonstration. Plumbers are resources, not application users." Classes="caption"/></StackPanel></Grid></Border>
 </StackPanel>
</UserControl>
