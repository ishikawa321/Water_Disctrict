<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WaterDistrict.Desktop.ViewModels"
        xmlns:app="using:WaterDistrict.Application"
        xmlns:views="using:WaterDistrict.Desktop.Views"
        x:Class="WaterDistrict.Desktop.Views.MainWindow" x:DataType="vm:MainViewModel"
        Title="Water District Administration" Width="1280" Height="860" MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#F8F9FB">
    <Grid>
        <!-- The mobile brand, expanded into a quiet two-column desktop welcome. -->
        <Grid ColumnDefinitions="0.95*,1.05*" IsVisible="{Binding IsSignedOut}">
            <Border Margin="20" CornerRadius="28" Padding="44" ClipToBounds="True">
                <Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Color="#E3ECFD" Offset="0" /><GradientStop Color="#EFF4FF" Offset="0.6" /><GradientStop Color="#F8F9FB" Offset="1" /></LinearGradientBrush></Border.Background>
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Image Source="/Assets/water-district-logo.png" Width="54" Height="54" />
                        <StackPanel VerticalAlignment="Center" Spacing="3"><TextBlock Text="Maramag Water District" FontSize="17" FontWeight="SemiBold" /><TextBlock Classes="muted" Text="Maramag, Philippines" FontSize="12" /></StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="22" Margin="0,28">
                        <Border Background="White" CornerRadius="22" Width="76" Height="76" HorizontalAlignment="Left">
                            <Viewbox Width="31" Height="39"><Path Data="M12,2 C12,2 3,12 3,18 A9,9 0 0 0 21,18 C21,12 12,2 12,2 Z M7,18 Q7,23 12,23" Stroke="#2563EB" StrokeThickness="1.5" Stretch="Uniform" /></Viewbox>
                        </Border>
                        <TextBlock Classes="eyebrow" Text="YOUR DISTRICT. CONNECTED." Foreground="#2563EB" />
                        <TextBlock Text="Better service.&#10;Every day." FontSize="46" FontWeight="SemiBold" LetterSpacing="-1.5" LineHeight="54" TextWrapping="Wrap" />
                        <TextBlock Classes="muted" Text="One workspace for the people keeping our water district moving." FontSize="17" LineHeight="27" TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Spacing="8"><TextBlock Text="Office administration" FontWeight="Medium" /><TextBlock Classes="muted" Text="For authorized Admin and Staff personnel" FontSize="12" TextWrapping="Wrap" /></StackPanel>
                </Grid>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid MinHeight="650" Margin="40,28">
                    <StackPanel MaxWidth="380" VerticalAlignment="Center" Spacing="14">
                        <TextBlock Classes="eyebrow" Text="WELCOME TO YOUR WORKSPACE" Margin="0,0,0,10" />
                        <TextBlock Text="Welcome back" FontSize="34" FontWeight="SemiBold" LetterSpacing="-0.8" />
                        <TextBlock Classes="muted" Text="Sign in with your office account to get started." TextWrapping="Wrap" Margin="0,0,0,20" />
                        <TextBlock Text="Email address" FontWeight="Medium" />
                        <TextBox Text="{Binding Email}" PlaceholderText="you@example.com" IsEnabled="{Binding !IsBusy}" AutomationProperties.Name="Email address" />
                        <TextBlock Text="Password" FontWeight="Medium" Margin="0,8,0,0" />
                        <TextBox Text="{Binding Password}" PasswordChar="*" PlaceholderText="Enter your password" IsEnabled="{Binding !IsBusy}" AutomationProperties.Name="Password" />
                        <Button Classes="primary" Content="Sign in" Command="{Binding SignInCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,12,0,0" IsDefault="True" MinHeight="48" />
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />
                        <Border Classes="feedback" IsVisible="{Binding HasMessage}"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></Border>
                        <TextBlock Classes="muted" Text="Need access? Contact the district administrator." TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
        <Grid ColumnDefinitions="252,*" IsVisible="{Binding IsSignedIn}">
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="16,26,16,18">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="24">
                    <Grid ColumnDefinitions="44,*" ColumnSpacing="12" Margin="10,0">
                        <Image Source="/Assets/water-district-logo.png" Width="44" Height="44" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock Text="Maramag" FontSize="19" FontWeight="SemiBold" /><TextBlock Classes="muted" Text="Water District" FontSize="12" /></StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="5">
                            <TextBlock Classes="eyebrow" Text="WORKSPACE" Margin="14,2,0,10" />
                            <Button Classes="nav home" Classes.active="{Binding IsOverview}" Content="Overview" Command="{Binding OverviewCommand}" />
                            <Button Classes="nav concerns" Classes.active="{Binding IsConcerns}" Content="Service concerns" Command="{Binding OpenConcernsCommand}" />
                            <Button Classes="nav repairs" Classes.active="{Binding IsTickets}" Content="Repair tickets" Command="{Binding OpenTicketsCommand}" />
                            <TextBlock Classes="eyebrow" Text="DISTRICT MANAGEMENT" Margin="14,24,0,10" IsVisible="{Binding IsAdmin}" />
                            <Button Classes="nav accounts" Classes.active="{Binding IsAccounts}" Content="Service accounts" Command="{Binding OpenOfficeCommand}" CommandParameter="Accounts" IsVisible="{Binding IsAdmin}" />
                            <Button Classes="nav bills" Classes.active="{Binding IsBills}" Content="Billing records" Command="{Binding OpenOfficeCommand}" CommandParameter="Bills" IsVisible="{Binding IsAdmin}" />
                            <Button Classes="nav payments" Classes.active="{Binding IsPayments}" Content="Verified payments" Command="{Binding OpenOfficeCommand}" CommandParameter="Payments" IsVisible="{Binding IsAdmin}" />
                            <Button Classes="nav announcements" Classes.active="{Binding IsAnnouncements}" Content="Announcements" Command="{Binding OpenOfficeCommand}" CommandParameter="Announcements" IsVisible="{Binding IsAdmin}" />
                            <Button Classes="nav staff" Classes.active="{Binding ShowDirectory}" Content="Staff directory" Command="{Binding LoadStaffCommand}" IsVisible="{Binding IsAdmin}" />
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Spacing="5">
                        <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="14,18,14,12">
                            <StackPanel Spacing="5"><TextBlock Text="{Binding DisplayName}" FontWeight="Medium" TextWrapping="Wrap" /><TextBlock Text="{Binding RoleLabel}" Classes="muted" FontSize="12" /></StackPanel>
                        </Border>
                        <Button Classes="nav refresh" Content="Refresh access" Command="{Binding RefreshAccessCommand}" />
                        <Button Classes="nav exit" Content="Sign out" Command="{Binding SignOutCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="32,18">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><TextBlock Classes="muted" Text="Office workspace" /><TextBlock Text="/" Foreground="#D1D5DB" /><TextBlock Text="{Binding WorkspaceTitle}" FontWeight="Medium" /></StackPanel>
                        <Border Grid.Column="1" Classes="badge"><TextBlock Text="{Binding RoleLabel}" Foreground="#2563EB" FontSize="12" FontWeight="Medium" /></Border>
                    </Grid>
                </Border>
                <Grid Grid.Row="1">
                    <Border Height="260" VerticalAlignment="Top" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="#EDF2FC" Offset="0" /><GradientStop Color="#F8F9FB" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="32,30" Spacing="22" MaxWidth="1440">
                            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />
                            <Border Classes="feedback" IsVisible="{Binding HasMessage}"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></Border>
                            <StackPanel Spacing="24" IsVisible="{Binding IsOverview}">
                                <StackPanel Spacing="8"><TextBlock Classes="eyebrow" Text="YOUR WORKSPACE" /><TextBlock Classes="page-title" Text="Dashboard" /></StackPanel>
                                <!-- Two headline tiles, same layout as the mobile Home. -->
                                <StackPanel Spacing="12" IsVisible="{Binding IsAdmin}">
                                    <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Classes="section-title" Text="District overview" /><TextBlock Classes="section-guide" Text="What needs attention right now." /></StackPanel>
                                        <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Refresh overview" Command="{Binding Office.LoadSummaryCommand}" /></Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="18" MinHeight="200">
                                    <Button Classes="tile primary" Command="{Binding OpenConcernsCommand}" AutomationProperties.Name="Pending concerns, opens service concerns">
                                        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                                            <Grid ColumnDefinitions="Auto,*,Auto"><Border Classes="icon-box"><Viewbox Width="20" Height="20"><Path Data="M4,3 L20,3 Q22,3 22,5 L22,16 Q22,18 20,18 L10,18 L4,22 L4,18 Q2,18 2,16 L2,5 Q2,3 4,3 M7,8 L17,8 M7,13 L14,13" Stroke="White" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" /></Viewbox></Border>
                                                <Viewbox Grid.Column="2" Width="16" Height="16" VerticalAlignment="Top"><Path Data="M5,19 L19,5 M8,5 L19,5 L19,16" Stroke="White" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" /></Viewbox></Grid>
                                            <TextBlock Grid.Row="1" Text="Pending concerns" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="3" Text="{Binding Office.PendingText}" FontSize="42" FontWeight="Bold" LetterSpacing="-1.2" Margin="0,22,0,0" />
                                            <TextBlock Grid.Row="4" Text="Waiting for review" FontSize="13" Opacity="0.85" TextWrapping="Wrap" />
                                        </Grid>
                                    </Button>
                                    <Button Grid.Column="1" Classes="tile" Command="{Binding OpenTicketsCommand}" AutomationProperties.Name="Active repairs, opens repair tickets">
                                        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                                            <Grid ColumnDefinitions="Auto,*,Auto"><Border Classes="icon-box"><Viewbox Width="20" Height="20"><Path Data="M15,3 L12,6 L15,9 L18,6 L21,6 Q22,12 16,14 L7,23 L2,18 L11,9 Q9,3 15,3 Z" Stroke="#2563EB" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" /></Viewbox></Border>
                                                <Viewbox Grid.Column="2" Width="16" Height="16" VerticalAlignment="Top"><Path Data="M5,19 L19,5 M8,5 L19,5 L19,16" Stroke="#111827" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" /></Viewbox></Grid>
                                            <TextBlock Grid.Row="1" Text="Active repairs" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="3" Text="{Binding Office.ActiveRepairsText}" FontSize="42" FontWeight="Bold" LetterSpacing="-1.2" Margin="0,22,0,0" />
                                            <TextBlock Grid.Row="4" Text="Assigned or in progress" FontSize="13" Opacity="0.85" Classes="muted" TextWrapping="Wrap" />
                                        </Grid>
                                    </Button>
                                    </Grid>
                                    <TextBlock Text="{Binding Office.Message}" TextWrapping="Wrap" Classes="muted" />
                                </StackPanel>
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2"><TextBlock Classes="section-title" Text="Quick actions" /><TextBlock Classes="section-guide" Text="Shortcuts to everyday office tasks." /></StackPanel>
                                    <UniformGrid Columns="3" ColumnSpacing="14" RowSpacing="14">
                                        <Button Classes="quick" Command="{Binding OpenConcernsCommand}" AutomationProperties.Name="Service concerns"><StackPanel Spacing="12"><Border Classes="circle-icon"><Viewbox Width="21" Height="21"><Path Data="M4,3 L20,3 Q22,3 22,5 L22,16 Q22,18 20,18 L10,18 L4,22 L4,18 Q2,18 2,16 L2,5 Q2,3 4,3 M7,8 L17,8 M7,13 L14,13" Stroke="White" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" /></Viewbox></Border><TextBlock Text="Service concerns" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel></Button>
                                        <Button Classes="quick" Command="{Binding OpenTicketsCommand}" AutomationProperties.Name="Repair tickets"><StackPanel Spacing="12"><Border Classes="circle-icon"><Viewbox Width="21" Height="21"><Path Data="M15,3 L12,6 L15,9 L18,6 L21,6 Q22,12 16,14 L7,23 L2,18 L11,9 Q9,3 15,3 Z" Stroke="White" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" /></Viewbox></Border><TextBlock Text="Repair tickets" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel></Button>
                                        <Button Classes="quick" Command="{Binding OpenOfficeCommand}" CommandParameter="Accounts" IsVisible="{Binding IsAdmin}" AutomationProperties.Name="Service accounts"><StackPanel Spacing="12"><Border Classes="circle-icon"><Viewbox Width="21" Height="21"><Path Data="M15,6 A4,4 0 1 1 7,6 A4,4 0 1 1 15,6 M2,22 L2,19 Q2,13 11,13 Q20,13 20,19 L20,22 Z" Stroke="White" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" /></Viewbox></Border><TextBlock Text="Service accounts" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel></Button>
                                        <Button Classes="quick" Command="{Binding OpenOfficeCommand}" CommandParameter="Bills" IsVisible="{Binding IsAdmin}" AutomationProperties.Name="Billing records"><StackPanel Spacing="12"><Border Classes="circle-icon"><Viewbox Width="21" Height="21"><Path Data="M5,2 L15,2 L21,8 L21,22 L5,22 Z M15,2 L15,8 L21,8 M9,12 L17,12 M9,17 L17,17" Stroke="White" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" /></Viewbox></Border><TextBlock Text="Billing records" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel></Button>
                                        <Button Classes="quick" Command="{Binding OpenOfficeCommand}" CommandParameter="Payments" IsVisible="{Binding IsAdmin}" AutomationProperties.Name="Verified payments"><StackPanel Spacing="12"><Border Classes="circle-icon"><Viewbox Width="21" Height="21"><Path Data="M3,4 L21,4 Q23,4 23,6 L23,19 Q23,21 21,21 L3,21 Q1,21 1,19 L1,6 Q1,4 3,4 M1,9 L23,9 M5,16 L10,16 M15,16 L19,16" Stroke="White" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" /></Viewbox></Border><TextBlock Text="Verified payments" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel></Button>
                                        <Button Classes="quick" Command="{Binding OpenOfficeCommand}" CommandParameter="Announcements" IsVisible="{Binding IsAdmin}" AutomationProperties.Name="Announcements"><StackPanel Spacing="12"><Border Classes="circle-icon"><Viewbox Width="21" Height="21"><Path Data="M3,9 L8,9 L20,3 L20,21 L8,15 L3,15 Z M8,15 L10,22 L6,22 L4,15" Stroke="White" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" /></Viewbox></Border><TextBlock Text="Announcements" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel></Button>
                                    </UniformGrid>
                                </StackPanel>
                                <Border Classes="card" Padding="20"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="5"><TextBlock Text="{Binding DisplayName}" FontWeight="Medium" /><TextBlock Classes="muted" Text="Signed in securely to your district workspace." FontSize="12" TextWrapping="Wrap" /></StackPanel><Border Grid.Column="1" Classes="badge" VerticalAlignment="Center"><TextBlock Text="{Binding RoleLabel}" Foreground="#2563EB" FontSize="12" /></Border></Grid></Border>
                            </StackPanel>
                            <Border IsVisible="{Binding IsOffice}"><views:OfficeView DataContext="{Binding Office}" /></Border>
                            <Border IsVisible="{Binding IsConcerns}"><views:ConcernsView DataContext="{Binding Workflows}" /></Border>
                            <Border IsVisible="{Binding IsTickets}"><views:TicketsView DataContext="{Binding Workflows}" /></Border>
                            <StackPanel IsVisible="{Binding ShowDirectory}" Spacing="22">
                                <StackPanel Spacing="8"><TextBlock Classes="page-title" Text="Staff directory" /><TextBlock Classes="guide" Text="Office personnel who can use this workspace." /></StackPanel>
                                <Border Classes="card"><StackPanel Spacing="18"><TextBlock Text="Active office personnel" Classes="section-title" /><TextBlock Classes="muted" Text="Accounts visible under your administrator permissions." TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding Staff}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="app:StaffMember"><Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,16"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{Binding DisplayName}" FontWeight="Medium" TextWrapping="Wrap" /><Border Grid.Column="1" Classes="badge"><TextBlock Text="{Binding Role}" Foreground="#2563EB" FontSize="12" /></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </StackPanel></Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
