<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:WaterDistrict.Desktop.ViewModels" xmlns:app="using:WaterDistrict.Application" xmlns:views="using:WaterDistrict.Desktop.Views"
 x:Class="WaterDistrict.Desktop.Views.TicketsView" x:DataType="vm:WorkflowViewModel">
 <StackPanel Spacing="18">
  <TextBlock Classes="page-title" Text="Repair tickets" />
  <TextBlock Classes="guide" Text="Staff see their assigned work. Progress reflects recorded updates from authorized personnel." />
  <ProgressBar Height="3" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
  <Border Classes="feedback" IsVisible="{Binding HasMessage}"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></Border>
  <Grid ColumnDefinitions="*,150,Auto" ColumnSpacing="10" IsEnabled="{Binding !IsBusy}">
   <TextBox Text="{Binding TicketSearch}" PlaceholderText="Search subject or account number" />
   <ComboBox Grid.Column="1" ItemsSource="{Binding TicketFilters}" SelectedItem="{Binding TicketFilter}" HorizontalAlignment="Stretch" />
   <Button Grid.Column="2" Content="Refresh" Command="{Binding LoadTicketsCommand}" />
  </Grid>
  <Grid ColumnDefinitions="260,*" ColumnSpacing="18" IsEnabled="{Binding !IsBusy}">
   <ListBox ItemsSource="{Binding Tickets}" SelectedItem="{Binding SelectedTicket}" VerticalAlignment="Top" MinHeight="350" MaxHeight="650" Background="White">
    <ListBox.ItemTemplate><DataTemplate x:DataType="app:TicketRecord"><StackPanel Spacing="7" Margin="4,8">
     <TextBlock Text="{Binding AccountNumber}" Classes="muted" FontSize="12" /><TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextWrapping="Wrap" />
     <views:StatusBadge Status="{Binding Status}" /><TextBlock Text="{Binding AssignedTo}" Classes="muted" TextWrapping="Wrap" />
    </StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <Border Grid.Column="1" Classes="card">
    <StackPanel Spacing="14">
     <TextBlock Text="Ticket detail and timeline" Classes="section-title" />
     <TextBlock Classes="muted" Text="Select a ticket to retrieve its saved status and history." TextWrapping="Wrap" />
     <StackPanel Spacing="12" IsVisible="{Binding HasTicket}">
      <TextBlock Text="{Binding SelectedTicket.Subject}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding SelectedTicket.AccountNumber}" /><views:StatusBadge Status="{Binding SelectedTicket.Status}" />
      <TextBlock Text="{Binding SelectedTicket.AssignedTo}" /><TextBlock Text="{Binding SelectedTicket.LatestUpdate}" TextWrapping="Wrap" />
      <Button Content="Reload saved detail and history" Command="{Binding LoadSelectedTicketCommand}" />
      <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="0,14,0,0">
       <StackPanel Spacing="10">
        <TextBlock Text="Record an update" FontSize="17" FontWeight="Bold" />
        <TextBlock Text="Status" /><ComboBox ItemsSource="{Binding NextTicketStates}" SelectedItem="{Binding TicketStatus}" HorizontalAlignment="Stretch" IsEnabled="{Binding CanEditTicket}" />
        <StackPanel Spacing="10" IsVisible="{Binding IsAdmin}">
         <TextBlock Text="Assign active staff" />
         <ComboBox ItemsSource="{Binding Assignees}" SelectedItem="{Binding SelectedAssignee}" HorizontalAlignment="Stretch" IsEnabled="{Binding CanEditTicket}" PlaceholderText="Select staff for Assigned status">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="app:StaffMember"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
         </ComboBox>
        </StackPanel>
        <TextBlock Text="Update / resolution note (required)" /><TextBox Text="{Binding TicketNote}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxLength="3000" IsEnabled="{Binding CanEditTicket}" />
        <Button Classes="primary" Content="Save ticket update" Command="{Binding SaveTicketCommand}" />
       </StackPanel>
      </Border>
      <TextBlock Text="Recorded history" Classes="section-title" />
      <ItemsControl ItemsSource="{Binding History}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="app:HistoryRecord">
       <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,12"><StackPanel Spacing="6">
        <views:StatusBadge Status="{Binding Status}" />
        <TextBlock Text="{Binding ChangedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Classes="muted" FontSize="12" />
        <TextBlock Text="{Binding ChangedBy}" FontWeight="Medium" /><TextBlock Text="{Binding AssignedTo}" Classes="muted" />
        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" />
       </StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
    </StackPanel>
   </Border>
  </Grid>
 </StackPanel>
</UserControl>
