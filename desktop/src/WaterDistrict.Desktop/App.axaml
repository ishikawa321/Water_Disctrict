<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WaterDistrict.Desktop.App" RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
        <Style Selector="TextBlock"><Setter Property="Foreground" Value="#17364B" /></Style>
        <Style Selector="Button"><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="18,12" /></Style>
        <Style Selector="Button.primary"><Setter Property="Background" Value="#086B83" /><Setter Property="Foreground" Value="White" /></Style>
        <Style Selector="Button.nav"><Setter Property="Background" Value="#194D62" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#31657A" /></Style>
        <Style Selector="TextBox"><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="12" /></Style>
        <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#5E7484" /></Style>
        <Style Selector="Border.card"><Setter Property="Background" Value="White" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="26" /></Style>
    </Application.Styles>
</Application>
