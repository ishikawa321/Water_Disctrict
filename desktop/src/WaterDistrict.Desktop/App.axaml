<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WaterDistrict.Desktop.App" RequestedThemeVariant="Light">
    <Application.Resources>
        <FontFamily x:Key="DistrictFont">avares://WaterDistrict.Desktop/Assets/Fonts#DM Sans</FontFamily>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window"><Setter Property="FontFamily" Value="{StaticResource DistrictFont}" /><Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="#111827" /></Style>
        <Style Selector="TextBlock"><Setter Property="Foreground" Value="#111827" /></Style>
        <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#6B7280" /></Style>
        <Style Selector="TextBlock.eyebrow"><Setter Property="FontSize" Value="11" /><Setter Property="LetterSpacing" Value="1.6" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#6B7280" /></Style>
        <Style Selector="TextBlock.page-title"><Setter Property="FontSize" Value="36" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="LetterSpacing" Value="-0.8" /></Style>
        <!-- Heading scale shared with the mobile app: page title, guide line, section title. -->
        <Style Selector="TextBlock.guide"><Setter Property="FontSize" Value="16" /><Setter Property="Foreground" Value="#6B7280" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="LineHeight" Value="22" /></Style>
        <Style Selector="TextBlock.section-title"><Setter Property="FontSize" Value="23" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="LetterSpacing" Value="-0.3" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
        <Style Selector="TextBlock.section-guide"><Setter Property="FontSize" Value="14.5" /><Setter Property="Foreground" Value="#6B7280" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
        <Style Selector="Button"><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="16,11" /><Setter Property="MinHeight" Value="42" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#E5E7EB" /><Setter Property="Foreground" Value="#111827" /></Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#F1F3F6" /><Setter Property="BorderBrush" Value="#D1D5DB" /></Style>
        <Style Selector="Button.primary"><Setter Property="Background" Value="#2563EB" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#2563EB" /></Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#1D4ED8" /><Setter Property="BorderBrush" Value="#1D4ED8" /></Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#1E40AF" /></Style>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="14" /><Setter Property="MinHeight" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Foreground" Value="#6B7280" /><Setter Property="Padding" Value="14,11" />
            <Setter Property="Template"><ControlTemplate>
                <Border Name="NavSurface" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="20,*" ColumnSpacing="12">
                        <Path Name="NavIcon" Width="18" Height="18" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" />
                        <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </Border>
            </ControlTemplate></Setter>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ Border#NavSurface"><Setter Property="Background" Value="#F3F4F6" /></Style>
        <Style Selector="Button.nav.active"><Setter Property="Background" Value="#EFF4FF" /><Setter Property="Foreground" Value="#2563EB" /></Style>
        <Style Selector="Button.nav.active:pointerover /template/ Border#NavSurface"><Setter Property="Background" Value="#E3ECFD" /></Style>
        <Style Selector="Button.nav:pressed /template/ Border#NavSurface"><Setter Property="Background" Value="#E5E7EB" /></Style>
        <Style Selector="Button.nav:focus-visible /template/ Border#NavSurface"><Setter Property="BorderBrush" Value="#2563EB" /><Setter Property="BorderThickness" Value="1" /></Style>
        <Style Selector="Button.nav.home /template/ Path#NavIcon"><Setter Property="Data" Value="M2,10 L12,2 L22,10 M5,9 L5,22 L10,22 L10,15 L14,15 L14,22 L19,22 L19,9" /></Style>
        <Style Selector="Button.nav.concerns /template/ Path#NavIcon"><Setter Property="Data" Value="M4,3 L20,3 Q22,3 22,5 L22,16 Q22,18 20,18 L10,18 L4,22 L4,18 Q2,18 2,16 L2,5 Q2,3 4,3 M7,8 L17,8 M7,13 L14,13" /></Style>
        <Style Selector="Button.nav.repairs /template/ Path#NavIcon"><Setter Property="Data" Value="M15,3 L12,6 L15,9 L18,6 L21,6 Q22,12 16,14 L7,23 L2,18 L11,9 Q9,3 15,3 Z" /></Style>
        <Style Selector="Button.nav.accounts /template/ Path#NavIcon"><Setter Property="Data" Value="M15,6 A4,4 0 1 1 7,6 A4,4 0 1 1 15,6 M2,22 L2,19 Q2,13 11,13 Q20,13 20,19 L20,22 Z" /></Style>
        <Style Selector="Button.nav.bills /template/ Path#NavIcon"><Setter Property="Data" Value="M5,2 L15,2 L21,8 L21,22 L5,22 Z M15,2 L15,8 L21,8 M9,12 L17,12 M9,17 L17,17" /></Style>
        <Style Selector="Button.nav.payments /template/ Path#NavIcon"><Setter Property="Data" Value="M3,4 L21,4 Q23,4 23,6 L23,19 Q23,21 21,21 L3,21 Q1,21 1,19 L1,6 Q1,4 3,4 M1,9 L23,9 M5,16 L10,16 M15,16 L19,16" /></Style>
        <Style Selector="Button.nav.announcements /template/ Path#NavIcon"><Setter Property="Data" Value="M3,9 L8,9 L20,3 L20,21 L8,15 L3,15 Z M8,15 L10,22 L6,22 L4,15" /></Style>
        <Style Selector="Button.nav.staff /template/ Path#NavIcon"><Setter Property="Data" Value="M12,6 A4,4 0 1 1 4,6 A4,4 0 1 1 12,6 M1,22 L1,19 Q1,13 8,13 Q15,13 15,19 L15,22 M17,3 Q23,3 23,7 Q23,11 17,11 M18,14 Q23,14 23,19 L23,22" /></Style>
        <Style Selector="Button.nav.refresh /template/ Path#NavIcon"><Setter Property="Data" Value="M20,8 A9,9 0 1 0 21,16 M20,2 L20,8 L14,8" /></Style>
        <Style Selector="Button.nav.exit /template/ Path#NavIcon"><Setter Property="Data" Value="M10,3 L3,3 L3,21 L10,21 M9,12 L23,12 M18,7 L23,12 L18,17" /></Style>
        <Style Selector="TextBox"><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="14,12" /><Setter Property="MinHeight" Value="44" /><Setter Property="Background" Value="#F3F4F6" /><Setter Property="BorderBrush" Value="#E5E7EB" /><Setter Property="SelectionBrush" Value="#BFDBFE" /></Style>
        <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="12,10" /><Setter Property="MinHeight" Value="44" /><Setter Property="Background" Value="#F3F4F6" /><Setter Property="BorderBrush" Value="#E5E7EB" /></Style>
        <Style Selector="DatePicker"><Setter Property="MinHeight" Value="44" /></Style>
        <Style Selector="ListBox"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#E5E7EB" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="18" /><Setter Property="Padding" Value="8" /></Style>
        <Style Selector="ListBoxItem"><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="12,8" /></Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#EFF4FF" /></Style>
        <Style Selector="Border.card"><Setter Property="Background" Value="White" /><Setter Property="CornerRadius" Value="20" /><Setter Property="Padding" Value="24" /><Setter Property="BorderBrush" Value="#E5E7EB" /><Setter Property="BorderThickness" Value="1" /></Style>
        <Style Selector="Border.feedback"><Setter Property="Background" Value="#EFF4FF" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="14" /></Style>
        <Style Selector="Border.badge"><Setter Property="Background" Value="#EFF4FF" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="10,6" /><Setter Property="HorizontalAlignment" Value="Left" /></Style>
        <!-- Headline tiles (same layout as the mobile Home): icon box + arrow, label, big number. -->
        <Style Selector="Button.tile"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#E5E7EB" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="18" /><Setter Property="Padding" Value="22" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="VerticalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" /></Style>
        <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#F1F3F6" /><Setter Property="BorderBrush" Value="#D1D5DB" /></Style>
        <Style Selector="Button.tile.primary"><Setter Property="Background" Value="#2563EB" /><Setter Property="BorderBrush" Value="#2563EB" /><Setter Property="Foreground" Value="White" /></Style>
        <Style Selector="Button.tile.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#1D4ED8" /><Setter Property="BorderBrush" Value="#1D4ED8" /></Style>
        <Style Selector="Button.tile.primary TextBlock"><Setter Property="Foreground" Value="White" /></Style>
        <Style Selector="Border.icon-box"><Setter Property="Width" Value="42" /><Setter Property="Height" Value="42" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Background" Value="#EFF4FF" /><Setter Property="HorizontalAlignment" Value="Left" /></Style>
        <Style Selector="Button.tile.primary Border.icon-box"><Setter Property="Background" Value="#29FFFFFF" /></Style>
        <!-- Quick actions: blue circle icon above a plain label. -->
        <Style Selector="Button.quick"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#E5E7EB" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="16" /><Setter Property="Padding" Value="14,20" /><Setter Property="MinHeight" Value="124" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
        <Style Selector="Button.quick:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#F1F3F6" /><Setter Property="BorderBrush" Value="#D1D5DB" /></Style>
        <Style Selector="Border.circle-icon"><Setter Property="Width" Value="48" /><Setter Property="Height" Value="48" /><Setter Property="CornerRadius" Value="24" /><Setter Property="Background" Value="#2563EB" /><Setter Property="HorizontalAlignment" Value="Center" /></Style>
    </Application.Styles>
</Application>
